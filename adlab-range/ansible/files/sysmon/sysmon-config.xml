<!-- Minimal Sysmon config for the lab range.
     Extend with the SwiftOnSecurity profile before real engagements. -->
<Sysmon schemaversion="4.82">
  <HashAlgorithms>md5,sha256</HashAlgorithms>
  <CheckRevocation>false</CheckRevocation>
  <EventFiltering>
    <RuleGroup name="ProcessCreate" groupRelation="or">
      <ProcessCreate onmatch="include">
        <CommandLine condition="contains">mimikatz</CommandLine>
        <CommandLine condition="contains">rubeus</CommandLine>
        <CommandLine condition="contains">certutil</CommandLine>
        <CommandLine condition="contains">setspn</CommandLine>
        <Image condition="endswith">powershell.exe</Image>
        <Image condition="endswith">cmd.exe</Image>
        <Image condition="endswith">psexec.exe</Image>
        <Image condition="endswith">rundll32.exe</Image>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="NetworkConnect" groupRelation="or">
      <NetworkConnect onmatch="include">
        <DestinationPort condition="is">88</DestinationPort>
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">389</DestinationPort>
        <DestinationPort condition="is">1433</DestinationPort>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="FileCreate" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="endswith">.kirbi</TargetFilename>
        <TargetFilename condition="endswith">.pfx</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
